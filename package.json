{
  "name": "figlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "dev": "turbo run dev --parallel",
    "openapi": "corepack pnpm --filter @figlab/api openapi",
    "test:compose": "node scripts/test-compose.mjs",
    "test:e2e": "corepack pnpm --filter @figlab/web test:e2e",
    "test:integration": "turbo run test:integration",
    "test:unit": "vitest run",
    "test:visual": "playwright test --grep @visual",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@changesets/cli": "2.29.7",
    "@netlify/functions": "6.0.2",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.0",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.2",
    "turbo": "2.10.9",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
