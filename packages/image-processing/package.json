{
  "name": "@figlab/image-processing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./vector": "./src/vector.ts",
    "./fonts/*": "./fonts/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:integration": "vitest run --passWithNoTests",
    "test:unit": "vitest run --root ../.. packages/image-processing/src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@figlab/api-contract": "workspace:*",
    "@figlab/figure-schema": "workspace:*",
    "@pdf-lib/fontkit": "1.1.1",
    "geotiff": "3.0.5",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@types/pngjs": "6.0.5",
    "pngjs": "7.0.0"
  }
}
