NODE_ENV=production
PUBLIC_APP_URL=http://localhost
API_HOST=0.0.0.0
API_PORT=3000
FIGLAB_BIND_ADDRESS=127.0.0.1
FIGLAB_HTTP_PORT=80
FIGLAB_MINIO_PORT=9000
FIGLAB_MINIO_CONSOLE_PORT=9001
POSTGRES_DB=figlab
POSTGRES_USER=figlab
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://figlab:change-me@postgres:5432/figlab
SINGLE_USER_EMAIL=local-admin@figlab.invalid
ALLOW_INSECURE_SINGLE_USER_REMOTE=false
OBJECT_STORE_BUCKET=figlab
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_INTERNAL_ENDPOINT=http://minio:9000
OBJECT_STORE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORE_ACCESS_KEY=figlab
OBJECT_STORE_SECRET_KEY=change-me
OBJECT_STORE_FORCE_PATH_STYLE=true
UPLOAD_URL_TTL_SECONDS=600
JOB_CONCURRENCY=2
MAX_UPLOAD_BYTES=104857600
MAX_IMAGE_PIXELS=100000000
MAX_EXPORT_EDGE_PX=16384
MAX_EXPORT_PIXELS=100000000
MAX_HISTORY_SNAPSHOTS=100
AUTOSAVE_DEBOUNCE_MS=1000
# Hosted mode (Supabase + Netlify); see README "Hosted deployment". Leave unset for local Compose.
# AUTH_MODE=supabase
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SECRET_KEY=
# STORAGE_DRIVER=supabase
# DATABASE_CA_CERT=   # contents of deploy/supabase-root-2021-ca.crt
# JOBS_TRIGGER_SECRET=
# VITE_AUTH_MODE=supabase
# VITE_SUPABASE_URL=https://<ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=
